@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - PsyNet</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/PsyNet.Web.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

	<link href='https://cdn.jsdelivr.net/npm/froala-editor@latest/css/froala_editor.pkgd.min.css' rel='stylesheet'
		type='text/css' />
	<script type='text/javascript'
		src='https://cdn.jsdelivr.net/npm/froala-editor@latest/js/froala_editor.pkgd.min.js'></script>
</head>

<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PsyNet.Web</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
					aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-light" asp-area="" asp-controller="Home"
								asp-action="Privacy">Privacy</a>
						</li>

						@if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
						{
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
									aria-expanded="false">
									Admin
								</a>
								<ul class="dropdown-menu">
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="AdminTags" asp-action="AddTag">
											Add Tag
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="AdminTags"
											asp-action="TagList">
											View Tags
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="BlogPost" asp-action="Add">
											Add blog
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="BlogPost" asp-action="List">
											All blogs
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="AdminUsers" asp-action="List">
											All Users
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="BlogReport" asp-action="List">
											View Blog Reports
										</a>
									</li>
									<li>
										<a class="dropdown-item" asp-area="" asp-controller="CommentReport"
											asp-action="List">
											View Comment Reports
										</a>
									</li>
								</ul>
							</li>

						}


					</ul>

					<div class="d-flex align-items-center">

						@if (SignInManager.IsSignedIn(User))
						{
							<div class="me-3 text-light">
								<p>Welcome, @User?.Identity?.Name</p>
							</div>
							<a class="btn me-3 bg-light text-dark" asp-area="" asp-controller="BlogPost"
								asp-action="Add">Make Blog</a>
							<a class="btn me-3 bg-light text-dark" asp-area="" asp-controller="BlogPost"
								asp-action="UserBlogs">My Blogs</a>
							<a class="btn me-3 bg-light text-dark" asp-area="" asp-controller="Account"
								asp-action="Logout">Logout</a>
						}
						else
						{
							<a class="btn me-3 bg-light text-dark" asp-area="" asp-controller="Account"
								asp-action="Login">Login</a>
							<a class="btn me-3 bg-light text-dark" asp-area="" asp-controller="Account"
								asp-action="Register">Register</a>
						}

					</div>

				</div>
			</div>
		</nav>
	</header>
	<div>
		<main role="main" class="pb-3">
			<div class="container mt-3">
				@if (TempData["NotificationMessage"] != null)
				{
					var notificationType = TempData["NotificationType"]?.ToString() ?? "info";
					<div class="alert alert-@notificationType alert-dismissible fade show" role="alert">
						@TempData["NotificationMessage"]
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				}
			</div>
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2025 - PsyNet.Web
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>
