@model PsyNet.Web.Models.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Details";
}

<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Patient Details</h1>
        <p class="lead">View patient information and AI medicine recommendations</p>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <!-- Patient Information -->
        <div class="col-12 col-lg-4 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person"></i> Patient Information</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Name:</strong>
                        @if (!string.IsNullOrEmpty(Model.PatientName))
                        {
                            <span>@Model.PatientName</span>
                        }
                        else
                        {
                            <span class="text-muted">Not specified</span>
                        }
                    </div>
                    <div class="mb-3">
                        <strong>Age:</strong> @Model.Age years old
                    </div>
                    <div class="mb-3">
                        <strong>Sex:</strong> @Model.Sex
                    </div>
                    <div class="mb-3">
                        <strong>Medical Condition:</strong>
                        <p class="mt-2">@Model.Condition</p>
                    </div>
                    <hr>
                    <div class="mb-2">
                        <small class="text-muted">
                            <i class="bi bi-calendar"></i> Created: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                        </small>
                    </div>
                </div>                <div class="card-footer">
                    <div class="d-flex gap-2">
                        <a asp-controller="MedicineAI" asp-action="SavedPatients" class="btn btn-secondary btn-sm">
                            <i class="bi bi-arrow-left"></i> Back to All Patients
                        </a>
                        <form method="post" asp-controller="MedicineAI" asp-action="DeletePatient" 
                              asp-route-id="@Model.Id" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this patient record? This will also delete all associated recommendations. This action cannot be undone.');">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete Patient
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medicine Recommendations -->
        <div class="col-12 col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-capsule"></i> AI Medicine Recommendations 
                        <span class="badge bg-light text-dark">@Model.Recommendations.Count</span>
                    </h4>
                </div>
                <div class="card-body">
                    @if (Model.Recommendations != null && Model.Recommendations.Any())
                    {
                        @foreach (var recommendation in Model.Recommendations)
                        {
                            <div class="card mb-3 @(recommendation.IsActive ? "border-success" : "border-secondary")">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">@recommendation.MedicineName</h5>
                                    <div>
                                        @if (recommendation.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(recommendation.Dosage))
                                    {
                                        <div class="mb-2">
                                            <strong>Dosage:</strong> @recommendation.Dosage
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(recommendation.Frequency))
                                    {
                                        <div class="mb-2">
                                            <strong>Frequency:</strong> @recommendation.Frequency
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(recommendation.Instructions))
                                    {
                                        <div class="mb-2">
                                            <strong>Instructions:</strong>
                                            <p class="mt-1">@recommendation.Instructions</p>
                                        </div>
                                    }
                                    <div class="mt-3">
                                        <small class="text-muted">
                                            <i class="bi bi-clock"></i> Generated: @recommendation.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                            @if (!string.IsNullOrEmpty(recommendation.RecommendationSource))
                                            {
                                                <span class="ms-3">
                                                    <i class="bi bi-gear"></i> Source: @recommendation.RecommendationSource
                                                </span>
                                            }
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-capsule display-4 text-muted"></i>
                            <h5 class="mt-3 text-muted">No Recommendations Yet</h5>
                            <p class="text-muted">AI recommendations are being processed for this patient.</p>
                        </div>
                    }
                </div>
                @if (Model.Recommendations != null && Model.Recommendations.Any())
                {
                    <div class="card-footer">
                        <div class="alert alert-warning mb-0">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Medical Disclaimer:</strong> These AI-generated recommendations are for informational purposes only. 
                            Always consult with a qualified healthcare professional before starting, stopping, or changing any medication.
                        </div>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex gap-2">
                <a asp-controller="MedicineAI" asp-action="Recommend" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add New Patient
                </a>
                <a asp-controller="MedicineAI" asp-action="SavedPatients" class="btn btn-outline-secondary">
                    <i class="bi bi-list"></i> View All Patients
                </a>
            </div>
        </div>
    </div>
</div>
