@using Microsoft.AspNetCore.Identity
@using PsyNet.Web.Models.Domain
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> userManager

@model PsyNet.Web.Models.ViewModels.BlogDetailsViewModel

@{
	ViewData["Title"] = Model.PageTitle;
}
<div class="container my-5">

	@* Notification Messages *@
	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Success"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@TempData["Error"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	<div class="row justify-content-center">
		<div class="col-12 col-lg-6">

			@if (Model != null)
			{
				<h1 class="mb-3">@Model.Heading</h1>

				<div class="d-flex justify-content-between mb-3">
					<span class="text-secondary">@Model.Author</span>
					<span class="text-secondary">@Model.PublishedDate.ToShortDateString()</span>
				</div>
				<div class="mb-3">
					@if (SignInManager.IsSignedIn(User))
					{
						<a id="btnLike" style="cursor: pointer;" data-liked="@Model.Liked.ToString().ToLower()">
							@if (Model.Liked)
							{
								<i class="bi bi-heart-fill text-danger"></i>
							}
							else
							{
								<i class="bi bi-heart"></i>
							}
						</a>
					}
					<span id="totalLikes">@Model.TotalLikes</span> likes
				</div>
				<div class="mb-3 d-flex">
					@foreach (var tag in Model.Tags)
					{
						<span class="badge bg-secondary me-1">@tag.Name</span>
					}
				</div>
	 @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
				{
					<img src="@Model.FeaturedImageUrl" alt="@Model.Heading" class="d-block img-fluid mb-3" />
				}
				else
				{
					<div class="d-block img-fluid mb-3 bg-light text-center py-5 border rounded">
						<i class="bi bi-image fs-1 text-muted"></i>
						<p class="text-muted mt-2 mb-0">No Image Available</p>
					</div>
				}

				<div class="mb-3 blog-details-content">
					@Html.Raw(Model.Content)
				</div>
				<div class="card">
					<div class="card-header">
						<h5>Comments</h5> @if (SignInManager.IsSignedIn(User))
						{
							<form method="post">
								<div asp-validation-summary="ModelOnly" class="text-danger"></div>
								<div class="mb-3">
									<label class="form-label">Comment Description</label>
									<input type="text" class="form-control" asp-for="CommentDescription" />
									<span asp-validation-for="CommentDescription" class="text-danger"></span>
								</div>
								<div class="mb-3">
									<button type="submit" class="btn btn-dark">Submit</button>
									<input type="hidden" asp-for="Id" />
									<input type="hidden" asp-for="UrlHandle" />
								</div>
							</form>
						}
					</div>
					<div class="card-body">
						@if (Model.Comments != null && Model.Comments.Any())
						{ @foreach (var comment in Model.Comments)
							{
								<div class="card mb-3">
									<div class="card-body">
										<div class="d-flex mb-3">
											<div class="me-3">
												@if (!string.IsNullOrEmpty(comment.ProfilePictureUrl))
												{
													<img src="@comment.ProfilePictureUrl" alt="@comment.Username"
														class="rounded-circle profile-pic-comment"
														style="width: 40px; height: 40px; object-fit: cover;">
												}
												else
												{
													<div class="rounded-circle d-flex align-items-center justify-content-center comment-avatar-placeholder"
														style="width: 40px; height: 40px;">
														<i class="bi bi-person-fill text-white" style="font-size: 1.2rem;"></i>
													</div>
												}
											</div>
											<div class="flex-grow-1">
												<div class="d-flex justify-content-between mb-2">
													<strong>@comment.Username</strong>
													<span class="text-secondary">@comment.DateAdded.ToShortDateString()</span>
												</div>
												<div>
													@comment.Description
												</div>
											</div>
										</div>

										<div class="mt-2 d-flex gap-2">
											@if (SignInManager.IsSignedIn(User) && User.Identity.Name == comment.Username)
											{
												<!-- Delete button for own comments -->
												<form method="post" asp-controller="BlogPostComment" asp-action="Delete"
													style="display: inline;">
													<input type="hidden" name="commentId" value="@comment.Id" />
													<input type="hidden" name="urlHandle" value="@Model.UrlHandle" />
													<button type="submit" class="btn btn-sm btn-outline-danger"
														onclick="return confirm('Are you sure you want to delete this comment?')">
														<i class="bi bi-trash"></i> Delete
													</button>
												</form>
											}
											@if (SignInManager.IsSignedIn(User) && User.Identity.Name != comment.Username)
											{
												<!-- Report button for other users' comments -->
												<a asp-controller="CommentReport" asp-action="Report" asp-route-commentId="@comment.Id"
													asp-route-blogPostId="@Model.Id" class="btn btn-sm btn-outline-warning">
													<i class="bi bi-flag"></i> Report
												</a>
											}
										</div>
									</div>
								</div>
							}
						}
						else
						{
							<div class="text-center py-4">
								<i class="bi bi-chat-square fs-1 text-muted"></i>
								<p class="text-muted mt-2 mb-0">There are no comments</p>
								<small class="text-muted">Be the first to comment on this blog post!</small>
							</div>
						}
					</div>
				</div>

				@if (SignInManager.IsSignedIn(User) && User.Identity.Name != Model.Author)
				{
					<div class="mt-3">
						<a asp-controller="BlogReport" asp-action="Report" asp-route-blogId="@Model.Id"
							class="btn btn-outline-danger">
							<i class="bi bi-flag"></i> Report Inappropriate Content
						</a>
					</div>
				}

			}
			else
			{
				<p>Blog post not found!</p>
			}
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		const btnLikeElement = document.getElementById('btnLike');
		const totalLikeElement = document.getElementById('totalLikes');

		if (btnLikeElement) {
			let isLiked = btnLikeElement.getAttribute('data-liked') === 'true';

			async function getTotalLikes() {
				fetch('/api/blogpostlike/@Model.Id/totalLikes', {
					method: 'GET',
					headers: {
						'Content-Type': 'application/json',
						'Accept': '*/*'
					}
				})
					.then(data => data.json())
					.then(result => totalLikeElement.innerHTML = result);
			}

			async function toggleLike() {
				const url = isLiked ? '/api/BlogPostLike/Remove' : '/api/BlogPostLike/Add';
				const method = isLiked ? 'DELETE' : 'POST';

				try {
					const response = await fetch(url, {
						method: method,
						headers: {
							'Content-Type': 'application/json',
							'Accept': '*/*'
						},
						body: JSON.stringify({
							blogPostId: '@Model.Id',
							userId: '@userManager.GetUserId(User)'
						})
					});

					if (response.ok) {
						// Toggle the like state
						isLiked = !isLiked;
						btnLikeElement.setAttribute('data-liked', isLiked.toString());

						// Update the icon
						const icon = btnLikeElement.querySelector('i');
						if (isLiked) {
							icon.className = 'bi bi-heart-fill text-danger';
						} else {
							icon.className = 'bi bi-heart';
						}

						// Update the total likes count
						await getTotalLikes();
					}
				} catch (error) {
					console.error('Error toggling like:', error);
				}
			}

			btnLikeElement.addEventListener('click', toggleLike);
		}

	</script>
}
 