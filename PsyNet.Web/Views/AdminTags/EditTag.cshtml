@model PsyNet.Web.Models.ViewModels.EditTagRequest
@{
}
<div class="bg-secondary bg-opacity-10 py-2">

    <div class="container">
        <h1>Edit Tag - Admin Functionality</h1>
    </div>
</div>

<div class="container py-5">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <h6>Please correct the following errors:</h6>
            @Html.ValidationSummary(true)
        </div>
    }

    @if (Model != null)
    {
        <form method="post">

            <div class="mb-3">
                <label class="form-label">Id</label>
                <input type="text" id="id" class="form-control" asp-for="Id" readonly />
            </div>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" id="name" class="form-control" asp-for="Name" />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Display Name</label>
                <input type="text" id="displayName" class="form-control" asp-for="DisplayName" />
                <span class="text-danger" asp-validation-for="DisplayName"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex">
                    <button type="submit" class="btn btn-dark">Update</button>

                    <button class="btn btn-danger ms-2" type="submit" asp-area="" asp-controller="AdminTags"
                        asp-action="Delete">
                        Delete
                    </button>
                </div>

            </div>

        </form>
    }
    else
    {
        <p>Tag not found</p>
    }

</div>

<script>
    const nameInput = document.getElementById("name");
    const displayNameInput = document.getElementById("displayName");
    const submitBtn = document.querySelector("button[type='submit']");
    const currentTagId = document.getElementById("id").value;

    // Check for spaces in Name field
    nameInput.addEventListener("input", function (e) {
        if (e.target.value.includes(" ")) {
            alert("Spaces are not allowed in the Name field.");
            e.target.value = e.target.value.replace(/\s/g, "");
        }
        checkTagNameExists(e.target.value);
    });

    // Check DisplayName when user types (input event) and when they finish typing (blur event)
    displayNameInput.addEventListener("input", function (e) {
        checkDisplayNameExists(e.target.value);
    });

    displayNameInput.addEventListener("blur", function (e) {
        checkDisplayNameExists(e.target.value);
    });

    async function checkTagNameExists(tagName) {
        if (!tagName || tagName.trim() === "") {
            clearValidationMessage("name");
            return;
        }

        try {
            const response = await fetch(`/AdminTags/CheckTagNameExistsForEdit?tagName=${encodeURIComponent(tagName)}&currentTagId=${currentTagId}`);
            const exists = await response.json();

            if (exists) {
                showValidationMessage("name", "This tag name already exists.");
                disableSubmit();
            } else {
                clearValidationMessage("name");
                enableSubmitIfValid();
            }
        } catch (error) {
            console.error("Error checking tag name:", error);
        }
    }

    async function checkDisplayNameExists(displayName) {
        console.log("Checking display name:", displayName); // Debug log
        console.log("Current tag ID:", currentTagId); // Debug log

        if (!displayName || displayName.trim() === "") {
            clearValidationMessage("displayName");
            return;
        }

        try {
            const url = `/AdminTags/CheckDisplayNameExistsForEdit?displayName=${encodeURIComponent(displayName)}&currentTagId=${currentTagId}`;
            console.log("Fetching URL:", url); // Debug log

            const response = await fetch(url);
            console.log("Response status:", response.status); // Debug log

            const exists = await response.json();
            console.log("Exists result:", exists); // Debug log

            if (exists) {
                showValidationMessage("displayName", "This display name already exists.");
                disableSubmit();
            } else {
                clearValidationMessage("displayName");
                enableSubmitIfValid();
            }
        } catch (error) {
            console.error("Error checking display name:", error);
        }
    }

    function showValidationMessage(fieldId, message) {
        const field = document.getElementById(fieldId);
        let errorSpan = field.parentElement.querySelector(".validation-error");

        if (!errorSpan) {
            errorSpan = document.createElement("span");
            errorSpan.className = "text-danger validation-error";
            field.parentElement.appendChild(errorSpan);
        }

        errorSpan.textContent = message;
        field.classList.add("is-invalid");
    }

    function clearValidationMessage(fieldId) {
        const field = document.getElementById(fieldId);
        const errorSpan = field.parentElement.querySelector(".validation-error");

        if (errorSpan) {
            errorSpan.remove();
        }

        field.classList.remove("is-invalid");
    }

    function disableSubmit() {
        submitBtn.disabled = true;
        submitBtn.classList.add("btn-secondary");
        submitBtn.classList.remove("btn-dark");
    }

    function enableSubmitIfValid() {
        const hasErrors = document.querySelectorAll(".validation-error").length > 0;

        if (!hasErrors) {
            submitBtn.disabled = false;
            submitBtn.classList.add("btn-dark");
            submitBtn.classList.remove("btn-secondary");
        }
    }

</script>






