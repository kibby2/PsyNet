@model PsyNet.Web.Models.ViewModels.ReportBlogViewModel

<div class="container py-5">
    <h1>Report Blog Post</h1>
    <h3>@Model.BlogPostTitle</h3>

    <div class="card mt-4">
        <div class="card-body">
            <form method="post" asp-controller="BlogReport" asp-action="SubmitReport">
                <input type="hidden" asp-for="BlogPostId" />
                <input type="hidden" asp-for="BlogPostTitle" />

                <div class="mb-3">
                    <label class="form-label">Why is this blog post inappropriate? (optional)</label>
                    <textarea class="form-control" asp-for="Comment" rows="4"
                        placeholder="Please describe why you're reporting this content..."></textarea>
                </div>

                <div class="d-flex">
                    <button type="submit" class="btn btn-danger">Submit Report</button>
                    <a class="btn btn-secondary ms-2" onclick="history.back()">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
                       