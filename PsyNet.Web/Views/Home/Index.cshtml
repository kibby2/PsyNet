@using Microsoft.AspNetCore.Identity
@using PsyNet.Web.Models.Domain
@inject SignInManager<ApplicationUser> SignInManager
@{
	ViewData["Title"] = "Home Page";
}

@model PsyNet.Web.Models.ViewModels.HomeViewModel

<div class="container col-xxl-8 px-4 py-5">
	<div class="row align-items-center g-5 py-5">
		<div class="col-12 col-lg-6">
			<h1 class="display-5 fw-bold lh-1 mb-3">
				PsyNet - Your stop for Psychology Articles
			</h1>
			<p class="lead">
				PsyNet aspires to be a dedicated online resource, offering a curated collection of psychology-related
				articles for professionals in the field. It aims to be a central hub for
				accessing a wide range of psychological information and research.
			</p>
		</div>

		<div class="col-12 col-lg-6">
			<img src="https://images.pexels.com/photos/57690/pexels-photo-57690.jpeg?auto=compress&cs=tinysrgb&w=600"
				alt="Psynet - Psychology blogs" class="d-block mx-lg-auto img-fluid" width="300" />
		</div>
	</div>
</div>

<!-- Medicine Recommendation AI Section -->
<div class="container py-4 bg-dark text-white rounded-3 mb-5">
	<div class="row justify-content-center text-center">
		<div class="col-12">
			<h2 class="mb-3 text-white">Medicine Recommendation AI</h2>
			<p class="lead mb-4 text-white">
				Enter your patient's age, sex, and condition to get suggested medication!
			</p>
			<div class="d-flex justify-content-center gap-3">
				@if (SignInManager.IsSignedIn(User))
				{
					<a class="btn btn-light text-dark btn-lg px-4" asp-controller="MedicineAI" asp-action="Recommend">
						<i class="bi bi-robot"></i> Try now
					</a>
					<a class="btn btn-outline-light btn-lg px-4" asp-controller="MedicineAI" asp-action="SavedPatients">
						<i class="bi bi-person-lines-fill"></i> View saved patients
					</a>
				}
				else
				{
					<a class="btn btn-light text-dark btn-lg px-4" asp-controller="Account" asp-action="Login"
						asp-route-ReturnUrl="/MedicineAI/Recommend">
						<i class="bi bi-robot"></i> Try now
					</a>
					<a class="btn btn-outline-light btn-lg px-4" asp-controller="Account" asp-action="Login"
						asp-route-ReturnUrl="/MedicineAI/SavedPatients">
						<i class="bi bi-person-lines-fill"></i> View saved patients
					</a>
				}
			</div>
		</div>
	</div>
</div>

<div class="container">
	<div class="row justify-content-center">
		<div class="col-12 col-lg-6">
			<h2 class="mb-4">Latest Blogs</h2>
			<p class="lead mb-4">
				Explore the latest articles and insights in the field of psychology.
			</p>
		</div>
	</div>
</div>

<div class="container">
	<div class="row justify-content-center">
		<div class="col-6 d-flex">
			@if (Model != null && Model.Tags.Any())
			{
				foreach (var tag in Model.Tags)
				{
					<span class="badge bg-dark me-1">
						@tag.Name
					</span>
				}
			}

		</div>
	</div>

</div>

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-6">
			@if (Model != null && Model.BlogPosts.Any())
			{
				foreach (var blogPost in Model.BlogPosts)
				{
					<div class="mb-5 bg-dark text-white box-shadow p-5"> @if (!string.IsNullOrEmpty(blogPost.FeaturedImageUrl))
						{
							<img src="@blogPost.FeaturedImageUrl" alt="@blogPost.Heading" class="mb-2 d-block img-fluid" />
						}
								else
						{
							<div class="mb-2 d-block img-fluid bg-secondary text-center py-4 border rounded">
								<i class="bi bi-image fs-3 text-light"></i>
								<p class="text-light mt-2 mb-0 small">No Image Available</p>
							</div>
						}

						<h2 class="mb-4 text-white">@blogPost.Heading</h2>
						<p class="mb-4 text-white">
							Author: @blogPost.Author
							<br />
							Published Date: @blogPost.PublishedDate.ToShortDateString()
						</p>

						<p class="mb-4">
							@foreach (var tag in blogPost.Tags)
							{
								<span class="badge bg-secondary me-1">@tag.Name</span>
							}
						</p>

						<p class="mb-4 text-white">@blogPost.ShortDescription</p>

						<a class="btn btn-light text-dark" asp-area="" asp-controller="Blogs" asp-action="Index"
							asp-route-urlHandle="@blogPost.UrlHandle">Read More</a>
					</div>

				}

				@* Pagination Controls *@
				@if (Model.TotalPages > 1)
				{
					<nav aria-label="Blog pagination" class="mt-4">
						<ul class="pagination justify-content-center">
							@* Previous button *@
							<li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
								<a class="page-link" asp-controller="Home" asp-action="Index"
									asp-route-page="@(Model.CurrentPage - 1)">
									<i class="bi bi-chevron-left"></i> Previous
								</a>
							</li>

							@* Page numbers *@
							@for (int i = 1; i <= Model.TotalPages; i++)
							{
								<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
									<a class="page-link" asp-controller="Home" asp-action="Index" asp-route-page="@i">@i</a>
								</li>
							}

							@* Next button *@
							<li class="page-item @(Model.HasNextPage ? "" : "disabled")">
								<a class="page-link" asp-controller="Home" asp-action="Index"
									asp-route-page="@(Model.CurrentPage + 1)">
									Next <i class="bi bi-chevron-right"></i>
								</a>
							</li>
						</ul>
					</nav>

					@* Pagination info *@
					<div class="text-center text-muted mt-3">
						<small>
							Showing page @Model.CurrentPage of @Model.TotalPages
							(@Model.TotalBlogs total blogs)
						</small>
					</div>
				}
			}
			else
			{
				<div class="text-center py-5">
					<i class="bi bi-journal-x fs-1 text-muted"></i>
					<h4 class="mt-3 text-muted">No blogs available</h4>
					<p class="text-muted">Check back later for new content!</p>
				</div>
			}
		</div>
	</div>
</div>
